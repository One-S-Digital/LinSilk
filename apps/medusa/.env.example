DATABASE_URL=postgres://linsilk:linsilk@localhost:5432/linsilk_medusa
REDIS_URL=redis://localhost:6379
JWT_SECRET=<openssl rand -base64 32>
COOKIE_SECRET=<openssl rand -base64 32>
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Where the storefront lives, used to build the payment link in a quote email.
STOREFRONT_URL=http://localhost:3000

# Where a new commission is announced. Without it, briefs are saved but
# nobody is told.
ATELIER_EMAIL=hello@linsilk.ch

# Email. Without a key, notifications are written to the log instead of sent.
RESEND_API_KEY=
RESEND_FROM=LinSilk <hello@linsilk.ch>

# Payment. Card, TWINT, Apple/Google Pay and Klarna are enabled in the Stripe
# dashboard; the store offers whatever that account allows for the currency.
# Without a key, checkout uses Medusa's system provider, which authorises
# without charging. Re-run the seed after setting this so regions pick Stripe up.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Object storage for cloth catalogues and commission references. Without a
# bucket, files are written to ./static, which does not survive a deploy.
# Cloudflare R2: region "auto", endpoint https://<account>.r2.cloudflarestorage.com
# Two buckets: S3_BUCKET holds what the public sees and may have a public
# domain (S3_FILE_URL); S3_PRIVATE_BUCKET holds commission references and must
# never have one. Required whenever S3_BUCKET is set.
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FILE_URL=
S3_PREFIX=

# The hosts the catalogue ingestion route will fetch photography from, comma
# separated (docs/CATALOGUE-INGESTION.md). Fetching a URL is the backend making
# a request on a caller's say-so, so nothing is fetched until this is set, and
# a redirect off one of these hosts is refused rather than followed.
CATALOGUE_IMAGE_HOSTS=

# Integration tests (.env.test): DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD
