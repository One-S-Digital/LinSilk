# Read from the host's environment in production (on Render, the service's
# environment group); from this file, copied to .env.local, in development.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle, so a change to
# any of them needs a redeploy — treat them as public. Everything below that
# is server-only and must never be prefixed NEXT_PUBLIC_.

NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# From the Medusa admin: Settings, Publishable API keys. It names a sales
# channel; it grants nothing else.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...

# Stripe's publishable key (pk_test_… while testing). Card details are entered
# inside Stripe's own frame, so no card number reaches this origin. Without
# it, checkout falls back to the backend's system provider, which authorises
# without charging — development only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Payload's own database — separate from Medusa's linsilk_medusa, on the same
# Postgres server (docker/init-db.sql creates it locally).
DATABASE_URI=postgres://linsilk:linsilk@localhost:5432/linsilk_payload

# Payload's encryption/signing secret. Never the same value as Medusa's
# JWT_SECRET or COOKIE_SECRET.
PAYLOAD_SECRET=<openssl rand -base64 32>
